{
  "name": "hermit",
  "version": "0.1.2",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "build:icon": "electron scripts/build-icon.cjs",
    "build:vendor": "esbuild vendor-src/rich-editor.mjs --bundle --minify --format=iife --target=chrome140 --legal-comments=eof --outfile=vendor/rich-editor.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12"
  },
  "productName": "Hermit",
  "description": "Codex·Claude Code 에이전트 작업공간(Windows PowerShell 5.1)",
  "author": "guseoh",
  "build": {
    "appId": "com.guseoh.agent-workbench",
    "productName": "Hermit",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!docs/**",
      "!profile/**",
      "!dist/**",
      "!output/**",
      "!tauri-bench/**",
      "!vendor-src/**",
      "!**/*.md",
      "!.claude/**",
      "!.github/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/hermit.ico",
      "artifactName": "Hermit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hermit"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guseoh",
        "repo": "hermit-releases",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "asar": false
  }
}
